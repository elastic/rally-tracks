{
  "name": "reload-and-steady-state",
  "description": "Reload historical data at high throughput, then run concurrent steady-state indexing and search. Phase 1 simulates a full data reload; Phase 2 simulates production steady-state load.",
  "schedule": [
    {
      "operation": "create-index-template"
    },
    {
      "operation": "delete-versioned-index"
    },
    {
      "operation": "create-versioned-index"
    },
    {
      "operation": "create-alias"
    },
    {
      "operation": "apply-reload-index-settings"
    },
    {
      "operation": "bulk-index-reload",
      "clients": {{ reload_clients | default(16) }},
      {% if reload_target_throughput is defined %}"target-throughput": "{{ reload_target_throughput }} docs/s",{% endif %}
      "warmup-time-period": 0,
      "ignore-response-error-level": "{{ error_level | default('non-fatal') }}"
    },
    {
      "operation": "update-index-settings-for-steady-state"
    },
    {
      "name": "steady-state",
      "parallel": {
        "completed-by": "bulk-index-new",
        "tasks": [
          {
            "operation": "bulk-index-new",
            "clients": {{ bulk_indexing_clients | default(8) }},
            {% if ingest_target_throughput is defined %}"target-throughput": "{{ ingest_target_throughput }} docs/s",{% endif %}
            "warmup-time-period": 0,
            "ignore-response-error-level": "{{ error_level | default('non-fatal') }}"
          },
          {"operation": "match-all", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "term-asset-type", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "term-status", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "range-created-at", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "range-view-count", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "range-file-size", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "match-title", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "match-content", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "phrase-title", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "bool-filter", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "bool-text-filter", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "desc-sort-created-at", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "desc-sort-view-count", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "asc-sort-created-at", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "keyword-terms-asset-type", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "keyword-terms-status", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "date-histogram-created-at", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "date-histogram-with-filter", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "multi-terms-type-status", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "tags-terms", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "query-string-content", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "term-workspace-id", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "term-owner-id", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "bool-workspace-asset-type", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "bool-owner-text", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"},
          {"operation": "bool-folder-status", "clients": 1, "warmup-time-period": 0, "target-throughput": "{{ search_target_throughput | default(2) }} ops/s"}
        ]
      }
    }
  ]
}

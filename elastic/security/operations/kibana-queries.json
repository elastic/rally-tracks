{#
  Individual Kibana Security queries, extracted from workflows/{hosts,overview,network}: one op per distinct query, using the first
  (Today/24h) variant of each. Each op description names the source workflow file and request step.
  - index: the workflow-target the composite workflows rewrite to (see track.json).
  - request-params: the recorded Kibana params merged with query_request_params, as the workflow-selector param source does.
  - time ranges: baked in as the workflow-selector renders them with default query parameters (recorded span, ending at 2020-01-02).
    query_max_date, query_max_date_start and query_average_interval do not affect these ops.
  - cache: the shard request cache is disabled, otherwise all but the first iteration of each size: 0 aggregation is a cache hit.
#}
{% macro kibana_search(recorded_request_params) -%}
  "operation-type": "search",
  "index": "{{ p_workflow_target }}",
  "cache": false,
  "request-params": {{ dict(recorded_request_params, **(query_request_params | default({}))) | tojson }}
{%- endmacro %}

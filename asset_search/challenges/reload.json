{
  "name": "reload",
  "description": "High-throughput bulk reload of historical data into a versioned index with alias. Simulates reloading from an external data store (e.g. DynamoDB).",
  "schedule": [
    {
      "operation": "create-index-template"
    },
    {
      "operation": "delete-versioned-index"
    },
    {
      "operation": "create-versioned-index"
    },
    {
      "operation": "create-alias"
    },
    {
      "operation": "apply-reload-index-settings"
    },
    {
      "operation": "bulk-index-reload",
      "clients": {{ reload_clients | default(16) }},
      {% if reload_target_throughput is defined %}"target-throughput": "{{ reload_target_throughput }} docs/s",{% endif %}
      "warmup-time-period": 0,
      "ignore-response-error-level": "{{ error_level | default('non-fatal') }}"
    }
  ]
}

{
  "name": "knn-search",
  "operation-type": "search",
  "param-source": "knn-search-param-source",
  "k": {{ knn_k | default(100) }},
  "num-candidates": {{ knn_num_candidates | default(256) }},
  "oversample": {{ oversample | default(none) | tojson }},
  "request-timeout": {{ search_request_timeout | default(600) }}
},
{
  "name": "esql-knn-search",
  "operation-type": "esql",
  "param-source": "esql-knn-param-source",
  "k": {{ knn_k | default(100) }},
  "num-candidates": {{ knn_num_candidates | default(256) }},
  "oversample": {{ oversample | default(none) | tojson }},
  "request-timeout": {{ search_request_timeout | default(600) }}
}

{
  "name": "ingest-and-search",
  "description": "Concurrent ingest and search from a cold start. Ingest runs at configurable throughput while the full search mix runs in parallel. Suitable for observing search latency during index growth and shard expansion events.",
  "schedule": [
    {
      "operation": "create-index-template"
    },
    {
      "operation": "delete-versioned-index"
    },
    {
      "operation": "create-versioned-index"
    },
    {
      "operation": "create-alias"
    },
    {
      "name": "ingest-and-search",
      "parallel": {
        "completed-by": "bulk-index",
        "tasks": [
          {
            "operation": "bulk-index",
            "clients": {{ bulk_indexing_clients | default(8) }},
            {% if ingest_target_throughput is defined %}"target-throughput": "{{ ingest_target_throughput }} docs/s",{% endif %}
            "warmup-time-period": 0,
            "ignore-response-error-level": "{{ error_level | default('non-fatal') }}"
          },
          {"operation": "match-all", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "term-asset-type", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "term-status", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "range-created-at", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "range-view-count", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "range-file-size", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "match-title", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "match-content", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "phrase-title", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "bool-filter", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "bool-text-filter", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "desc-sort-created-at", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "desc-sort-view-count", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "asc-sort-created-at", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "keyword-terms-asset-type", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "keyword-terms-status", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "date-histogram-created-at", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "date-histogram-with-filter", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "multi-terms-type-status", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "tags-terms", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "query-string-content", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "term-workspace-id", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "term-owner-id", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "bool-workspace-asset-type", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "bool-owner-text", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"},
          {"operation": "bool-folder-status", "clients": 1, "target-throughput": "{{ search_target_throughput | default(5) }} ops/s"}
        ]
      }
    }
  ]
}

{
  "name": "hosts-authentications-histogram",
  "description": "hosts/5.json 5.1",
  {{ kibana_search({"batched_reduce_size": "64", "ignore_unavailable": "true", "track_total_hits": "true", "allow_no_indices": "true"}) }},
  "body": {
    "aggregations": {
      "eventActionGroup": {
        "terms": {
          "field": "event.outcome",
          "include": [
            "success",
            "failure"
          ],
          "order": {
            "_count": "desc"
          },
          "size": 2
        },
        "aggs": {
          "events": {
            "date_histogram": {
              "field": "@timestamp",
              "fixed_interval": "30s",
              "min_doc_count": 0,
              "extended_bounds": {
                "min": 1577919600000,
                "max": 1577923200000
              },
              "time_zone": "UTC"
            }
          }
        }
      }
    },
    "query": {
      "bool": {
        "filter": [
          {
            "bool": {
              "must": [],
              "filter": [],
              "should": [],
              "must_not": []
            }
          },
          {
            "bool": {
              "must": [
                {
                  "term": {
                    "event.category": "authentication"
                  }
                }
              ]
            }
          },
          {
            "range": {
              "@timestamp": {
                "gte": "2020-01-01T23:00:00.000Z",
                "lte": "2020-01-02T00:00:00.000Z",
                "format": "strict_date_optional_time"
              }
            }
          }
        ]
      }
    },
    "size": 0
  }
},

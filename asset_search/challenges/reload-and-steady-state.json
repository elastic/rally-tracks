{
  "name": "reload-and-steady-state",
  "description": "Reload historical data at high throughput, then run concurrent steady-state indexing and search. Phase 1 simulates a full data reload; Phase 2 simulates production steady-state load.",
  "schedule": [
    {
      "operation": "create-index-template"
    },
    {
      "operation": "delete-versioned-index"
    },
    {
      "operation": "create-versioned-index"
    },
    {
      "operation": "create-alias"
    },
    {
      "operation": "update-index-settings-for-reload"
    },
    {
      "operation": "bulk-index-reload",
      "clients": {{ reload_clients | default(16) }},
      {% if reload_target_throughput is defined %}"target-throughput": "{{ reload_target_throughput }} docs/s",{% endif %}
      "warmup-time-period": 0,
      "ignore-response-error-level": "{{ error_level | default('non-fatal') }}"
    },
    {
      "operation": "update-index-settings-for-steady-state"
    },
    {
      "name": "steady-state",
      "parallel": {
        "completed-by": "bulk-index-new",
        "tasks": [
          {
            "operation": "bulk-index-new",
            "clients": {{ bulk_indexing_clients | default(8) }},
            {% if ingest_target_throughput is defined %}"target-throughput": "{{ ingest_target_throughput }} docs/s",{% endif %}
            "ignore-response-error-level": "{{ error_level | default('non-fatal') }}"
          },
          {"operation": "match-all", "clients": 1, "weight": 1},
          {"operation": "term-asset-type", "clients": 1, "weight": 5},
          {"operation": "term-status", "clients": 1, "weight": 5},
          {"operation": "range-created-at", "clients": 1, "weight": 5},
          {"operation": "range-view-count", "clients": 1, "weight": 3},
          {"operation": "range-file-size", "clients": 1, "weight": 2},
          {"operation": "match-title", "clients": 1, "weight": 8},
          {"operation": "match-content", "clients": 1, "weight": 8},
          {"operation": "phrase-title", "clients": 1, "weight": 5},
          {"operation": "bool-filter", "clients": 1, "weight": 8},
          {"operation": "bool-text-filter", "clients": 1, "weight": 8},
          {"operation": "desc-sort-created-at", "clients": 1, "weight": 5},
          {"operation": "desc-sort-view-count", "clients": 1, "weight": 5},
          {"operation": "asc-sort-created-at", "clients": 1, "weight": 3},
          {"operation": "keyword-terms-asset-type", "clients": 1, "weight": 4},
          {"operation": "keyword-terms-status", "clients": 1, "weight": 4},
          {"operation": "date-histogram-created-at", "clients": 1, "weight": 4},
          {"operation": "date-histogram-with-filter", "clients": 1, "weight": 4},
          {"operation": "multi-terms-type-status", "clients": 1, "weight": 3},
          {"operation": "tags-terms", "clients": 1, "weight": 4},
          {"operation": "query-string-content", "clients": 1, "weight": 6}
        ]
      }
    }
  ]
}

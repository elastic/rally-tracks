{
  "name": "search-only",
  "description": "Run search operations against an already-indexed dataset",
  "schedule": [
    {
      "name": "search",
      "parallel": {
        "clients": {{ search_clients | default(8) }},
        "warmup-iterations": {{ warmup_iterations | default(500) }},
        "iterations": {{ search_iterations | default(1000) }},
        "tasks": [
          {"operation": "match-all", "weight": 1},
          {"operation": "term-asset-type", "weight": 5},
          {"operation": "term-status", "weight": 5},
          {"operation": "range-created-at", "weight": 5},
          {"operation": "range-view-count", "weight": 3},
          {"operation": "range-file-size", "weight": 2},
          {"operation": "match-title", "weight": 8},
          {"operation": "match-content", "weight": 8},
          {"operation": "phrase-title", "weight": 5},
          {"operation": "bool-filter", "weight": 8},
          {"operation": "bool-text-filter", "weight": 8},
          {"operation": "desc-sort-created-at", "weight": 5},
          {"operation": "desc-sort-view-count", "weight": 5},
          {"operation": "asc-sort-created-at", "weight": 3},
          {"operation": "keyword-terms-asset-type", "weight": 4},
          {"operation": "keyword-terms-status", "weight": 4},
          {"operation": "date-histogram-created-at", "weight": 4},
          {"operation": "date-histogram-with-filter", "weight": 4},
          {"operation": "multi-terms-type-status", "weight": 3},
          {"operation": "tags-terms", "weight": 4},
          {"operation": "query-string-content", "weight": 6}
        ]
      }
    }
  ]
}

{%- set p_index_mode = index_mode | default('logsdb' if enable_logsdb else none) %}
{%- set p_logsdb_like = p_index_mode in ['logsdb', 'logsdb_columnar'] %}
{#- the base settings block is omitted for non-operator serverless runs, so later settings must not start with a comma then #}
{%- set p_has_base_settings = build_flavor != "serverless" or serverless_operator == true %}
{
  "settings": {
    {# non-serverless-index-settings-marker-start #}{%- if build_flavor != "serverless" or serverless_operator == true -%}
    "index.number_of_shards": {{ number_of_shards | default(5) }},
    "index.number_of_replicas": {{ number_of_replicas | default(0) }},
    "index.requests.cache.enable": false
    {%- endif -%}{# non-serverless-index-settings-marker-end #}
    {%- if p_logsdb_like %}{{ "," if p_has_base_settings else "" }}
    "index.mode": "{{ p_index_mode }}",
    {% if synthetic_source_keep %}
    "index.mapping.synthetic_source_keep": "{{synthetic_source_keep}}",
    {% endif %}
    {% if use_doc_values_skipper | default(true)  %}
    "index.mapping.use_doc_values_skipper" : "true",
    {% endif %}
    "index.sort.field": ["@timestamp"],
    "index.sort.order":["desc"]
    {%- elif p_index_mode %}{{ "," if p_has_base_settings else "" }}
    "index.mode": "{{ p_index_mode }}"
    {%- endif %}
    {% if source_mode %}
    {{ "," if p_has_base_settings or p_index_mode else "" }}"mapping.source.mode": {{ source_mode | tojson }}
    {% endif %}
  },
  "mappings": {
    "dynamic": "strict",
    {%- if p_logsdb_like %}
    {%- else %}
    "_source": {
      "enabled": {{ source_enabled | default(true) | tojson }}
    },
    {%- endif %}
    "properties": {
      "@timestamp": {
        {%- if ingest_pipeline_name is defined and ingest_pipeline_name == "grok" %}
        "format": "strict_date_optional_time",
        {%- else %}
        "format": "epoch_second",
        {%- endif %}
        "type": "date"
      },
      "message": {
        {%- if p_index_mode == "logsdb_columnar" %}
        {# columnar index modes require all fields to be reconstructable from doc values #}
        "type": "keyword"
        {%- else %}
        "type": "keyword",
        "index": false,
        "doc_values": false
        {%- endif %}
      },
      "clientip": {
        "type": "ip"
      },
      "request": {
        "type": "match_only_text",
        "fields": {
          "raw": {
            "ignore_above": 256,
            "type": "keyword"
          }
        }
      },
      "status": {
        "type": "integer"
      },
      "size": {
        "type": "integer"
      },
      "geoip" : {
        "properties" : {
          "country_name": { "type": "keyword" },
          "city_name": { "type": "keyword" },
          "location" : { "type" : "geo_point" }
        }
      }
    }
  }
}
